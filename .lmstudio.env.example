# LM Studio 本地服务（本地真实 LLM 链路验证，无需真实 DeepSeek key）
# 使用方式：cp .lmstudio.env.example .lmstudio.env，启动 LM Studio server 后：
#   LLM_ENV_PROFILE=lmstudio uvicorn services.api.main:app --reload
LLM_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://127.0.0.1:7224/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=your-local-model
LMSTUDIO_TIMEOUT_SECONDS=120
AUDIO_RENDERER=fallback
