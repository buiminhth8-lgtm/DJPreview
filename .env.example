# 通用默认配置（所有 profile 都会加载 .env 作为基础配置）。
# 建议把 .env 留给通用配置（音频渲染等），LLM Provider 专项配置放到 profile env 文件。

# LLM profile 选择（也可通过 LLM_ENV_PROFILE / LLM_ENV_FILE 环境变量选择）：
#   mock      -> .mock.env       MockProvider（默认，稳定回归）
#   lmstudio  -> .lmstudio.env   LM Studio 本地服务
#   deepseek  -> .deepseek.env   DeepSeek 线上服务
# 复制 example 为真实文件（如 copy .mock.env.example .mock.env）后按需切换。

LLM_PROVIDER=mock

# DeepSeek（线上真实 LLM）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=60

# LM Studio（本地 OpenAI-compatible 服务，真实 LLM 链路验证）
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=local-model
LMSTUDIO_TIMEOUT_SECONDS=120

# 通用 OpenAI-compatible（Ollama / vLLM / LocalAI 等）
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=120

# 音频渲染（第三阶段）
AUDIO_RENDERER=auto
FLUIDSYNTH_BIN=fluidsynth
SOUNDFONT_PATH=
AUDIO_SAMPLE_RATE=44100
AUDIO_GAIN=0.6
